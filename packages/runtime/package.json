  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@openclaw/gateway-client": "2026.11.3",
    "@openclaw/gateway-protocol": "2026.11.3",
    "@taia/types": "workspace:*",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
