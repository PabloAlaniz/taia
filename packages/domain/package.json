{
  "name": "@taia/domain",
  "version": "1.0.0-alpha.3",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./domain/*": "./src/domain/*",
    "./infrastructure/*": "./src/infrastructure/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@taia/types": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "vitest": "^5.1.1"
  }
}
