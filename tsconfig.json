{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@taia/types": ["packages/types/src"],
      "@taia/types/*": ["packages/types/src/*"],
      "@taia/core": ["packages/core/src"],
      "@taia/core/*": ["packages/core/src/*"],
      "@taia/domain": ["packages/domain/src"],
      "@taia/domain/*": ["packages/domain/src/*"],
      "@taia/runtime": ["packages/runtime/src"],
      "@taia/runtime/*": ["packages/runtime/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "apps/*/src/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", "**/__tests__"]
}
