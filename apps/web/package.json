{
  "name": "@taia/web",
  "version": "1.0.0-alpha.3",
  "private": true,
  "scripts": {
    "dev": "node scripts/ws-server.js & next dev -p ${APP_PORT:-13333} -H ${TAIA_BIND_HOST:-127.0.0.1}",
    "dev:next": "next dev -p ${APP_PORT:-13333} -H ${TAIA_BIND_HOST:-127.0.0.1}",
    "build": "next build",
    "start": "node scripts/ws-server.js & next start -p ${APP_PORT:-13333} -H ${TAIA_BIND_HOST:-127.0.0.1}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@openclaw/gateway-client": "2026.11.6",
    "@openclaw/gateway-protocol": "2026.11.6",
    "@taia/core": "workspace:*",
    "@taia/domain": "workspace:*",
    "@taia/runtime": "workspace:*",
    "@taia/types": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff2html": "^3.4.56",
    "lucide-react": "^1.75.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.3",
    "next-themes": "^0.4.6",
    "omnilimit": "^0.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "ws": "^8.23.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.1"
  }
