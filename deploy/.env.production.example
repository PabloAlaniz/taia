# TAIA — Variables de entorno para producción
#
# Copiá este archivo a `.env` y ajustá los valores:
#   cp deploy/.env.production.example .env
#
# Luego levantá el stack con Caddy + TLS:
#   docker compose -f docker-compose.yml -f deploy/docker-compose.prod.yml up -d --build

# ─── Dominio / acceso ────────────────────────────────────────────────────────
# Con dominio real (Caddy pide certificado TLS automáticamente):
DOMAIN=taia.tudominio.com
#
# Sin dominio, solo por IP/LAN (HTTP plano, ideal para demo o Raspberry Pi):
#   DOMAIN=:80
#   WS_CLIENT_URL=ws://TU_IP_PUBLICA/ws   # <- obligatorio en este caso (ver abajo)

# ─── Base de datos (Postgres en contenedor — por defecto) ────────────────────
POSTGRES_USER=taia
POSTGRES_DB=taia
# Generá una contraseña fuerte, p.ej.:  openssl rand -base64 24
POSTGRES_PASSWORD=cambiame-por-una-contraseña-fuerte

# ─── Token de acceso (obligatorio) ───────────────────────────────────────────
# Lo piden la web, la API, el MCP y el WebSocket. Quien lo tiene, tiene acceso
# completo.   openssl rand -hex 32
TAIA_API_TOKEN=

# ─── Secretos en la base ─────────────────────────────────────────────────────
# Cifra los tokens y API keys de los runtimes y los secretos de webhooks que
# TAIA guarda en PostgreSQL. Generala una vez y no la pierdas: sin ella no se
# pueden leer los secretos ya guardados.   openssl rand -base64 32
TAIA_SECRET_KEY=

# ─── Base de datos gestionada (Neon / Supabase / Cloud SQL) — opcional ───────
# Si usás Postgres gestionado en vez del contenedor:
#   1) Descomentá DATABASE_URL con tu connection string.
#   2) Levantá sin el servicio postgres con deploy/docker-compose.external-db.yml (ver https://pabloalaniz.github.io/taia/guias/deploy/).
# DATABASE_URL=postgresql://usuario:password@host:5432/taia?sslmode=require

# ─── WebSocket (tiempo real) ─────────────────────────────────────────────────
# Por defecto se deriva de DOMAIN como wss://${DOMAIN}/ws (con TLS).
# Solo necesitás setearlo a mano si servís por HTTP/IP sin dominio:
# WS_CLIENT_URL=ws://TU_IP_PUBLICA/ws

